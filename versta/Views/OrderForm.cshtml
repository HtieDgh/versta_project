@model versta.Views.OrderFormViewModel
@{
    ViewBag.Title="Создание заказа";
    Layout = "/Views/_Layout.cshtml";
}

<h2 class="text-center mb-3">@ViewBag.Title</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <form method="post" action="/orders/new" novalidate="novalidate">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger mb-3">@Model.ErrorMessage</div>
            }

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success mb-3">@Model.SuccessMessage</div>
            }
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Отправитель</h5>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label asp-for="SenderCity" class="control-label"></label>
                        <input asp-for="SenderCity" class="form-control" />
                        <span asp-validation-for="SenderCity" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="SenderAddress" class="control-label"></label>
                        <input asp-for="SenderAddress" class="form-control" />
                        <span asp-validation-for="SenderAddress" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5>Получатель</h5>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label asp-for="RecipientCity" class="control-label"></label>
                        <input asp-for="RecipientCity" class="form-control" />
                        <span asp-validation-for="RecipientCity" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="RecipientAddress" class="control-label"></label>
                        <input asp-for="RecipientAddress" class="form-control" />
                        <span asp-validation-for="RecipientAddress" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5>Параметры груза</h5>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label asp-for="Weight" class="control-label"></label>
                        <input asp-for="Weight" class="form-control" type="number" step="0.1" min="0.1" max="10000" />
                        <span asp-validation-for="Weight" class="text-danger"></span>
                        
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PickupDate" class="control-label"></label>
                        <input asp-for="PickupDate" class="form-control" type="date" />
                        <span asp-validation-for="PickupDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary btn-lg">Создать заказ</button>
            </div>
        </form>

    </div>
</div>

@* Секция для скриптов (будет вставлена в _Layout)*@
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
}
@section Css {
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
}