@model versta.Views.OrderListViewModel
@{
    ViewBag.Title = "Список заказов";
    Layout = "/Views/_Layout.cshtml";
}
<div class="card-orders">
    <div class="card-header-custom">
        <h4>
            <i class="bi bi-box-seam"></i>
            Заказы
            <span style="font-size: 0.9rem; font-weight: 500; color: #6b7f99; margin-left: auto;">
                Отображено: @Model.Orders.Count
            </span>
        </h4>
    </div>

    <!-- Список заказов -->
    <div class="order-list" id="orderListContainer">
        <!-- Заказ 1 -->
        @if (@Model.Orders.Count == 0)
        {
            <p class="text-center mt-3">Заказов не найдено</p>
        }
        @foreach (var o in Model.Orders)
        {
            <div class="order-item" data-order-id="ORD-1024">
                <div class="order-header" role="button" tabindex="0">
                    <div class="order-id">
                        <span>📦 Заказ</span>
                        <span class="badge-id">ID: @o.OrderID</span>
                    </div>
                    <div class="order-status">
                        <span class="order-toggle"><i class="bi bi-chevron-down"></i></span>
                    </div>
                </div>
                <div class="order-details">
                    <div class="detail-grid">
                        <div class="detail-item">
                            <span class="detail-label"><i class="bi bi-send"></i> Город отправителя</span>
                            <span class="detail-value"><i class="bi bi-geo-alt"></i> @o.SenderCity</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label"><i class="bi bi-house-door"></i> Адрес отправителя</span>
                            <span class="detail-value"><i class="bi bi-pin-map"></i> @o.SenderAddress</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label"><i class="bi bi-arrow-right-circle"></i> Город получателя</span>
                            <span class="detail-value"><i class="bi bi-geo-alt"></i> @o.RecipientCity</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label"><i class="bi bi-house-heart"></i> Адрес получателя</span>
                            <span class="detail-value"><i class="bi bi-pin-map"></i> @o.RecipientAddress</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label"><i class="bi bi-weight-scale"></i> Вес (кг)</span>
                            <span class="detail-value"><span class="weight-badge"><i class="bi bi-database"></i> @o.Weight</span></span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label"><i class="bi bi-calendar-event"></i> Дата забора</span>
                            <span class="detail-value"><span class="date-badge"><i class="bi bi-calendar3"></i> @o.Date.ToString("yyyy.MM.dd")</span></span>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>

    <div class="footer-meta">
        <span>Нажмите на <i class="bi bi-chevron-down"></i> у заказа для получения деталей</span>
    </div>
</div>

@section Scripts{
    <script src="/js/jquery-4.0.0.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>

    <script>
        $(function() {
            // Обработчик клика на заголовок заказа (раскрытие/скрытие)
            $('.order-header').on('click', function(e) {
                const $parentItem = $(this).closest('.order-item');
                const isOpen = $parentItem.hasClass('open');

                // Переключаем текущий
                $parentItem.toggleClass('open');

                // Опционально: скролл к открытому элементу
                if (!isOpen) {
                    setTimeout(() => {
                        $parentItem[0]?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }, 100);
                }
            });
        });
    </script>
}
@section Css{
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/order_list.css" />
}