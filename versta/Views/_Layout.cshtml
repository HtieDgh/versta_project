<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    @await RenderSectionAsync("Css", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">Versta</a>
                <!-- Меню навигации -->
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/orders/new">Создать заказ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/orders">Список заказов</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3 row justify-content-center">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Versta - <a href="https://github.com/HtieDgh/versta_project" target="_blank">HtieDgh</a>
        </div>
    </footer>

    @*  Секция для дополнительных скриптов (например, на странице формы) *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
